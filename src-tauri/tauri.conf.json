{
  "productName": "streameoIPTV",
  "version": "1.5.2",
  "identifier": "com.kaveyro.streameo-iptv",
  "build": {
    "frontendDist": "../dist/streameoIPTV/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "ng build --configuration=production"
  },
  "app": {
    "windows": [
      {
        "title": "streameoIPTV",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http: data: blob: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' https: http: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNjNFOTYxQzhCQjhEMDgKUldRSWpidklZZWxqdTBzTHo2anllc3pxM28xUGhqdHhuNk85dlAwT1JhQXBDRklWaFFvWW9QQmMK",
      "endpoints": [
        "https://github.com/kaveyro/streameoIPTV/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "mpv",
          "ffmpeg",
          "yt-dlp"
        ],
        "desktopTemplate": "linux/custom.desktop"
      },
      "rpm": {
        "depends": [
          "mpv",
          "ffmpeg",
          "yt-dlp"
        ],
        "desktopTemplate": "linux/custom.desktop"
      }
    }
  },
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json"
}